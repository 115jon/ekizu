@PACKAGE_INIT@

set(@PROJECT_NAME@_VERSION @PROJECT_VERSION@)

include(CMakeFindDependencyMacro)

# Find required dependencies
# Boost - works with both vcpkg Boost (CONFIG) and system Boost (Module)
# Only list compiled libraries; header-only libs come via Boost::headers
find_dependency(Boost REQUIRED COMPONENTS filesystem coroutine)

find_dependency(fmt)
find_dependency(nlohmann_json)
find_dependency(certify)
find_dependency(Opus)
find_dependency(unofficial-sodium)
find_dependency(ZLIB)
find_dependency(libdave)

include("${CMAKE_CURRENT_LIST_DIR}/@PROJECT_NAME@Targets.cmake")
check_required_components(@PROJECT_NAME@)